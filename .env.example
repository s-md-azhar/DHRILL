# ==============================================================================
# DHRILL API Provider Credentials (Optional Frontier Fallbacks)
# Core DeBERTa-v3 cross-encoder and MiniLM embeddings evaluate 100% locally.
# API keys are only needed for compound sentence decomposition & ambiguity arbitration.
# ==============================================================================

# Google Gemini API Key (Tier 1 Fallback <= 12 RPM throttle)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Tier 2 Fallback <= 25 RPM throttle)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Tier 3 Fallback <= 15 RPM throttle)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Host & Port configuration
DHRILL_HOST=127.0.0.1
DHRILL_PORT=8000
